# name: test/sql/fuzzycomplete_cli_columns.test
# description: sql_auto_complete returns the five-column shape the DuckDB shell and the stock autocomplete extension use
# group: [fuzzycomplete]

require fuzzycomplete

# The shell reads (suggestion, suggestion_start, suggestion_type, suggestion_score, extra_char) by position
query TT
SELECT column_name, column_type FROM (DESCRIBE SELECT * FROM sql_auto_complete('SELEC'));
----
suggestion	VARCHAR
suggestion_start	INTEGER
suggestion_type	VARCHAR
suggestion_score	UBIGINT
extra_char	VARCHAR

# Keywords end in a space, which is reported as the extra character
query TITIT
SELECT replace(suggestion, ' ', '_'), suggestion_start, suggestion_type, suggestion_score, replace(extra_char, ' ', '_')
FROM sql_auto_complete('SELEC');
----
SELECT_	0	keyword	0	_

statement ok
CREATE TABLE customer_order_history (order_total INTEGER);

query TITIT
SELECT * FROM sql_auto_complete('SELECT * FROM cstmr_ord_hst');
----
customer_order_history	14	table	0	NULL

query TITIT
SELECT * FROM sql_auto_complete('SELECT ordr_ttl') LIMIT 1;
----
order_total	7	column	0	NULL

# Catalog and schema suggestions end in '.', like the stock extension
statement ok
ATTACH ':memory:' AS other;

statement ok
CREATE TABLE other.main.widgets (x INTEGER);

query TITIT
SELECT * FROM sql_auto_complete('SELECT * FROM othr') LIMIT 3;
----
other.	14	catalog	0	.
other.main.	14	schema	0	.
other.main.widgets	14	table	0	NULL

query TT
SELECT suggestion, suggestion_type FROM sql_auto_complete('SELECT * FROM generate_ser')
WHERE suggestion LIKE '%.generate_series';
----
"system".main.generate_series	table_function

# Scalar functions offered in column position
query TT
SELECT suggestion, suggestion_type FROM sql_auto_complete('SELECT conca')
WHERE suggestion = 'concat';
----
concat	scalar_function

# The best match scores 0; the others report their distance from it (lower is better, equal scores are ties)
query I
SELECT min(suggestion_score) = 0 AND max(suggestion_score) > 0 FROM sql_auto_complete('SELECT * FROM othr');
----
true

# File and directory suggestions end in the quote / path separator
query TITT
SELECT rtrim(suggestion, '/\'), suggestion_start, suggestion_type, extra_char IN ('/', '\')
FROM sql_auto_complete('SELECT * FROM ''test/sq');
----
sql	20	directory	true

query TITIT
SELECT * FROM sql_auto_complete('SELECT * FROM ''test/sql/fuzzycomplete.te') LIMIT 1;
----
fuzzycomplete.test'	24	file_name	0	'

# Named parameters of the stock extension are accepted
query I
SELECT count(*) FROM sql_auto_complete('SEL', max_suggestion_count := 1);
----
1

query I
SELECT (SELECT count(*) FROM sql_auto_complete('S', max_exact_suggestion_count := 5))
     = (SELECT count(*) FROM sql_auto_complete('S'));
----
true
