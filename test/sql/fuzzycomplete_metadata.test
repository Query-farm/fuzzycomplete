# name: test/sql/fuzzycomplete_metadata.test
# description: duckdb_functions() documents sql_auto_complete
# group: [fuzzycomplete]

require fuzzycomplete

query TTTT
SELECT function_name, function_type, parameters, parameter_types
FROM duckdb_functions() WHERE function_name = 'sql_auto_complete';
----
sql_auto_complete	table	[sql, max_suggestion_count, max_file_suggestion_count, max_exact_suggestion_count]	[VARCHAR, UBIGINT, UBIGINT, UBIGINT]

# Every function of the extension has a description, an example and categories
query I
SELECT count(*) FROM duckdb_functions()
WHERE function_name = 'sql_auto_complete'
  AND (description IS NULL OR description = '' OR len(examples) = 0 OR len(categories) = 0);
----
0

query T
SELECT list_contains(categories, 'autocomplete') FROM duckdb_functions() WHERE function_name = 'sql_auto_complete';
----
true
